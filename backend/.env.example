# Backend only. Copy the direct/session-pooler PostgreSQL connection string from Supabase Connect.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Comma-separated auth.users UUIDs, not usernames or emails. Empty denies all admin access.
ADMIN_USER_IDS=
# Comma-separated exact frontend origins; include each trusted deployment alias.
FRONTEND_URL=http://localhost:3000
PORT=5000
