{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "esnext",
    // "types": [],   ← remove this line
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },

  "include": ["routes/**/*", "services/**/*", "middleware/**/*", "types/**/*", "index.ts", "services/locationService.test.ts"],
  "exclude": ["node_modules", "dist"]
}